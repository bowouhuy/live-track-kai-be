# Interval (seconds) between SSE position broadcasts. FE reads it from /api/config.
BROADCAST_INTERVAL_SECONDS=5

# Comma-separated origins allowed to call the API (CORS). "*" = any.
# Production example: https://kereta.example.com
CORS_ALLOWED_ORIGINS=*

# Host binding for the published port. 127.0.0.1 = only reachable via reverse proxy on the VPS.
# Use 0.0.0.0 to expose directly on the public IP (http://IP:8080).
BIND_ADDR=127.0.0.1
HOST_PORT=8080

# VPS with Caddy in its own container: uncomment to join the shared network
# (no host port is published then). Create the network once: docker network create web
# COMPOSE_FILE=docker-compose.yml:docker-compose.caddy.yml
# CADDY_NETWORK=web
